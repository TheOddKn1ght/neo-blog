# Example Nginx virtual host for oddknight.space.
#
# This serves the static Zola output in dist/ and optionally proxies the
# Telegram contact form. Mirrors the behavior of server.ts (directory
# indexes, custom 404, cache lifetimes, security headers, /message proxy).
#
# Deploy:
#   bun run build
#   rsync -a --delete dist/ /var/www/oddknight.space/dist/
#   sudo cp nginx.conf.example /etc/nginx/sites-available/oddknight.space
#   sudo ln -s /etc/nginx/sites-available/oddknight.space /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d oddknight.space   # fills in ssl_certificate lines
#   sudo nginx -t && sudo systemctl reload nginx
#
# Optional Telegram contact form (the home-page form posts {"message":"..."}
# to /message). Without it the form renders but reports a send failure:
#   TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=... bun run serve:message
# which listens on 127.0.0.1:3001 by default (MESSAGE_PORT to change it).
#
# NOTE: every location that sets add_header repeats the security headers.
# Nginx discards inherited add_header directives as soon as a location adds
# its own, so omitting them would drop them on cached assets.

server {
    listen 80;
    listen [::]:80;
    server_name oddknight.space;

    # Let certbot answer HTTP-01 challenges before the redirect below.
    location /.well-known/acme-challenge/ {
        root /var/www/oddknight.space/dist;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name oddknight.space;

    # Managed by certbot --nginx (uncomment and adjust if issuing manually):
    # ssl_certificate /etc/letsencrypt/live/oddknight.space/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/oddknight.space/privkey.pem;

    root /var/www/oddknight.space/dist;
    index index.html;
    charset utf-8;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    # Uncomment once you are sure all subdomains serve HTTPS:
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    error_page 404 /404.html;

    # HTML and extensionless routes (/blog/my-post serves /blog/my-post/index.html).
    # no-cache so deploys take effect immediately (matches server.ts).
    location / {
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Hashed/immutable-ish static assets use the same 1h lifetime as server.ts.
    # Safe to raise (e.g. `expires 1y; ... "public, max-age=31536000, immutable"`)
    # for /assets/ and /css/ since their names/URLs carry content hashes.
    location ~* \.(js|css|xml|txt)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Images and fonts (matches server.ts).
    location ~* \.(jpg|jpeg|png|webp|gif|avif|svg|ico|ttf|otf|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
        access_log off;
    }

    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Telegram contact-form backend (message.ts). POST-only, 16k max body.
    location = /message {
        limit_except POST {
            deny all;
        }
        client_max_body_size 16k;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
}
